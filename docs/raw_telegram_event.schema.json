{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RawTelegramEvent",
  "description": "Unprocessed Telegram message event",
  "allOf": [
    { "$ref": "./raw_osint_event.schema.json" }
  ],
  "properties": {
    "source": {
      "type": "string",
      "const": "telegram"
    },
    "data": {
      "type": "object",
      "properties": {
        "event_type": {
          "type": "string"
        },
        "chat_id": {
          "type": "integer"
        },
        "channel_title": {
          "type": "string"
        },
        "channel_main_lang": {
          "type": "string"
        },
        "msg_id": {
          "type": "integer"
        }
      },
      "required": ["event_type", "chat_id", "channel_title", "channel_main_lang", "msg_id"]
    }
  },
  "required": ["source", "data"]
}
