{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RawOsintEvent",
  "description": "Base class for all unprocessed osint events",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  },
  "required": ["id", "timestamp", "source"]
}
